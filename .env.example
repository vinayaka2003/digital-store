# ==========================================================================
# Digital Store — Environment Variables Configuration Template
# Copy this file to 'frontend/.env.local' and 'backend/.env' (for Express backup)
# ==========================================================================

# 1. Store public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Database Connection (Neon PostgreSQL)
# Server-only. Do NOT prefix with NEXT_PUBLIC_
DATABASE_URL=postgresql://[user]:[password]@[neon-host]/[db-name]?sslmode=require

# 3. Razorpay Payments Mode
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# 4. Razorpay Webhook Secret (For server-to-server payments confirmation)
# Server-only. Do NOT prefix with NEXT_PUBLIC_
RAZORPAY_WEBHOOK_SECRET=...

# 5. Token cryptographic secret key
# Server-only. Do NOT prefix with NEXT_PUBLIC_
JWT_SECRET=0d9f3a8c6b2e1f7d4a5c9e8b3f1d6a2c7e4b9f5d1a8c3e6f2b7d9a4e1c8f5b6
ADMIN_SECRET=0d9f3a8c6b2e1f7d4a5c9e8b3f1d6a2c7e4b9f5d1a8c3e6f2b7d9a4e1c8f5b6

# 6. Admin Authentication Credentials
# Server-only. Do NOT prefix with NEXT_PUBLIC_
ADMIN_USER=admin
ADMIN_PASS=change_this_password_123

# 7. Transactional Email Service (Resend API)
# Server-only. Do NOT prefix with NEXT_PUBLIC_
EMAIL_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev

# 8. Google Drive Delivery Assets (Expiring link generator)
# Server-only. Do NOT prefix with NEXT_PUBLIC_
GOOGLE_DRIVE_CLIENT_ID=...
GOOGLE_DRIVE_CLIENT_SECRET=...
GOOGLE_DRIVE_REFRESH_TOKEN=...

# 9. Migration & Rollback Toggle
# Set to 'true' to redirect checkout requests to the legacy Express server (port 4000)
# Set to 'false' or remove to run native Next.js API Routes (Neon PostgreSQL)
NEXT_PUBLIC_USE_EXPRESS=false
